# Copiar como .env y completar. El archivo .env NUNCA se commitea (.gitignore).
# Lo leen: docker-compose.yml, db/seed/seed_db.py y db/scripts/medir_indices.py.

# Conexión (instalación local de PostgreSQL)
PGHOST=localhost
PGPORT=5432
PGDATABASE=bodegas_atuel

# Superusuario: crea la base y aplica las migraciones.
# En Docker es la contraseña del usuario postgres del contenedor.
PGUSER=postgres
PGPASSWORD=

# Contraseñas de los roles (db/scripts/asignar_passwords.sql)
PG_PROPIETARIO_PASSWORD=
PG_APP_RW_PASSWORD=
PG_SOLO_LECTURA_PASSWORD=

# Docker: puerto de la PC donde se publica la base del contenedor.
# Si ya tenés PostgreSQL instalado usando el 5432, poné 5433.
DB_PORT=5432
